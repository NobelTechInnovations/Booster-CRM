PORT=5200

# Must match SMART_WHATSAPP_SHARED_SECRET in commerce-backend's own env
# exactly — generate one long random string and use it in both places.
SMART_WHATSAPP_SHARED_SECRET=

# commerce-backend's own URL, so this service can push inbound messages to
# it the instant they arrive.
BACKEND_URL=http://localhost:4000

# Where each company's WhatsApp login session is stored on this host's own
# disk. Must be a real, persistent path (not wiped on restart/redeploy) —
# see README.md.
SESSIONS_DIR=./sessions
