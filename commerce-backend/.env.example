PORT=4000
HOST=127.0.0.1
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:3000
MONGODB_URI=mongodb+srv://nobeltechinnovations:QROI2yIqUV7I0GyY@noobeltechapp.h6m2bpc.mongodb.net/booster?retryWrites=true&w=majority&appName=noobeltechapp
JWT_SECRET=change-me-in-production

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_inventory,read_customers,write_customers
SHOPIFY_APP_URL=http://localhost:4000
SHOPIFY_API_VERSION=2026-01

AMAZON_APP_URL=http://localhost:4000
SHOPIFY_APP_INSTALL_URL=

META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_APP_URL=http://localhost:4000
META_SCOPES=ads_read,business_management
# Social (Instagram/Facebook) connects through the same Meta App above but
# its own OAuth callback — add this as an additional "Valid OAuth Redirect
# URI" in the Meta App dashboard alongside the existing Ads one:
#   {META_APP_URL}/api/social/meta/callback

# WhatsApp Cloud API. Per-company phone number + access token are entered
# in-app (Settings -> WhatsApp -> Connect), not here — only the shared
# webhook verification config lives in env, since Meta supports one webhook
# URL + verify token per Meta App (not per company). Set the webhook URL in
# the Meta App's WhatsApp product config to {META_APP_URL}/api/whatsapp/webhook
# and WHATSAPP_WEBHOOK_VERIFY_TOKEN to any string of your choosing (must
# match exactly on both sides).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# "Smart WhatsApp" — a separate, unofficial integration that pairs with a
# real WhatsApp number via WhatsApp Web-style QR scan instead of Meta's
# Cloud API (see smart-whatsapp-service/README.md). SERVICE_URL points at
# that standalone service (it must be hosted somewhere with a persistent
# process — a VPS, e.g. Hostinger — not Vercel). SHARED_SECRET must be set
# to the exact same value as that service's own SMART_WHATSAPP_SHARED_SECRET.
SMART_WHATSAPP_SERVICE_URL=
SMART_WHATSAPP_SHARED_SECRET=

# Platform Admin (app/admin) — a completely separate login for the people who
# run Booster itself (not a company's own users). Own JWT secret on purpose:
# a leaked/forged company token must never be replayable as admin access, and
# vice versa. Set this to a real random value in production; the first admin
# account is created locally via `node scripts/seed-platform-admin.js`.
PLATFORM_ADMIN_JWT_SECRET=

# Razorpay — collects wallet recharges and plan upgrades FOR the platform
# itself (a single Booster-owned account, not per-company). key_id/key_secret
# come from Razorpay's dashboard -> Settings -> API Keys. webhook_secret is
# set separately when adding the webhook URL there (Settings -> Webhooks ->
# {META_APP_URL}/api/billing/webhook, event: payment.captured) — it is NOT
# the same value as key_secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend — transactional email (trial-ending reminders, payment receipts).
# Get RESEND_API_KEY from resend.com; RESEND_FROM_EMAIL must be an address
# on a domain you've verified there (falls back to Resend's own shared
# onboarding@resend.dev sender, fine for testing, not for real use).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
